# Copy to backend/.env (ignored by git) and run with: uv run --env-file .env python -m overhearth
# Development on the Claude API instead of Amazon Bedrock:
OVERHEARTH_DIALOGUE=anthropic
OVERHEARTH_ASSISTANT=anthropic
ANTHROPIC_API_KEY=
# OVERHEARTH_ANTHROPIC_MODEL=claude-haiku-5-5
OVERHEARTH_DEV_ENDPOINTS=1
