{
  "name": "overhearth-web",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "typecheck": "tsc --noEmit && tsc --noEmit -p town && tsc --noEmit -p diary",
    "preview": "vite preview",
    "build:town": "vite build --config vite.town.config.ts",
    "build:diary": "vite build --config vite.diary.config.ts",
    "build:views": "npm run build:town && npm run build:diary"
  },
  "dependencies": {
    "@modelcontextprotocol/client": "^2.3.1",
    "@modelcontextprotocol/ext-apps": "^2.0.3",
    "pixi.js": "^8.22.0",
    "three": "^0.186.1"
  },
  "devDependencies": {
    "@types/three": "^0.186.0",
    "typescript": "^7.0.2",
    "vite": "^8.3.4",
    "vite-plugin-singlefile": "^2.3.4"
  }
}
